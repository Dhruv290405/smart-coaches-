# Brevo alert emails (bad odour, brake binding, hot axle, ACP, CR overcharge).
# Email alerts ride along with push/in-app alerts for the types below.
EMAIL_ALERTS_ENABLED=true
EMAIL_ALERT_TYPES=BRAKE_BINDING,CR_OVERCHARGE,HOT_AXLE,ACP,ODOUR
# Don't email the same recipient the same alert type more often than this.
EMAIL_ALERT_COOLDOWN_MS=900000
# Hard daily cap to protect the Brevo quota.
EMAIL_DAILY_LIMIT=250
