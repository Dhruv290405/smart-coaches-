# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Database Configuration
DB_HOST=103.227.176.27
DB_USER=smartcoachadmin
DB_PASSWORD=miDf5k8P8Y5
DB_NAME=railway
DB_PORT=3306

# Logging
LOG_LEVEL=info

# Odour Section 2 Supabase (dedicated project for Bad Odour Management Section 2)
ODOUR2_SUPABASE_URL=
ODOUR2_SUPABASE_SERVICE_KEY=

# Brevo transactional email OTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Smart Coach

# Brevo alert emails (bad odour, brake binding, hot axle, ACP, CR overcharge).
# Email alerts ride along with push/in-app alerts for the types below.
EMAIL_ALERTS_ENABLED=true
EMAIL_ALERT_TYPES=BRAKE_BINDING,CR_OVERCHARGE,HOT_AXLE,ACP,ODOUR
# Don't email the same recipient the same alert type more often than this.
EMAIL_ALERT_COOLDOWN_MS=900000
# Hard daily cap to protect the Brevo quota.
EMAIL_DAILY_LIMIT=250

# Weekly location reports (Monday 09:00 IST by default).
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=1
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_MINUTE=0
WEEKLY_REPORT_WINDOW_MINUTES=14
WEEKLY_REPORT_ROLE_IDS=1,2,3,4
WEEKLY_REPORT_EXCLUDE_EMAILS=tester@example.com
